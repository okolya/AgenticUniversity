# Keep the University core mechanically consistent and free of private data.
# Sourced by the pre-commit hook after `cd` to the repo root, under `set -e`.
# Runs only when a file under university/ or scripts/ is staged. The link and
# manifest checks have their own fragments; this runs the remaining core checks.

if command -v python3 >/dev/null 2>&1 && [ -f scripts/check-core.py ]; then
    if git diff --cached --name-only --diff-filter=ACMRD | grep -qE '^(university|scripts)/'; then
        python3 scripts/check-core.py
    fi
else
    echo "⚠️  python3 or scripts/check-core.py missing; core integrity check skipped"
fi
